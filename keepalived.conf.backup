vrrp_script chk_pg {
    script "/etc/ha/ha-check.sh"
    interval 3
    fall 2
    rise 2
}
vrrp_instance VI_1 {
    state BACKUP          # обе ноды BACKUP + nopreempt — VIP не скачет
    interface eno1
    virtual_router_id 77  # ДОЛЖЕН быть уникален в офисной сети! (51 — дефолт Mikrotik)
    priority 100
    nopreempt
    advert_int 1
    authentication { auth_type PASS auth_pass HaVip26 }   # max 8 символов
    virtual_ipaddress { 192.168.88.50/24 dev eno1 }
    track_script { chk_pg }
    notify_master /etc/ha/become-master.sh
    notify_backup /etc/ha/become-backup.sh
}
